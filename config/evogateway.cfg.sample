#------------------------------------------------------------------------------
# evoGateway – Example Configuration File
#
# This file contains ALL supported configuration parameters defined in config.py
# with clear comments explaining what each setting does.
#
# Copy this file to:   config/evogateway.cfg
#------------------------------------------------------------------------------


#------------------------------------------------------------------------------
# SERIAL PORT SETTINGS
#------------------------------------------------------------------------------
[Serial Port]

# Serial device where your HGI is connected
COM_PORT = /dev/ttyUSB0

# Baud rate for UART communication
COM_BAUD = 115200



#------------------------------------------------------------------------------
# FILE & LOGGING SETTINGS
#------------------------------------------------------------------------------
[Files]

# Log of high-level events (schemas saved, MQTT commands, etc.)
EVENTS_FILE = events.log

# Log of raw packets from ramses_rf
PACKET_LOG_FILE = packet.log

# Number of days to retain rotated packet logs
PACKET_LOG_RETENTION_DAYS = 7

# Rotate packet.log when this many bytes are reached
LOG_FILE_ROTATE_BYTES = 1000000

# RamsesRF schema file (auto-generated / updated by the gateway)
SCHEMA_FILE = ramses_rf_schema.json

# Save schema at every shutdown (default is to save on shutdown only when in discovery mode)
ALWAYS_SAVE_SCHEMA_ON_SHUTDOWN = False

# Maximum number of schema snapshots to keep
MAX_SAVE_FILE_COUNT = 9



#------------------------------------------------------------------------------
# MQTT SETTINGS
#------------------------------------------------------------------------------
[MQTT]

# MQTT broker hostname or IP
MQTT_SERVER = 192.168.1.10

# Auth (leave blank if no authentication required)
MQTT_USER =
MQTT_PW   =

# MQTT client ID presented to the broker
MQTT_CLIENTID = evoGateway

# Publish ONLY full JSON messages (no key/value breakdown)
MQTT_PUB_AS_JSON = False

# Publish both JSON and individual key/value pairs
# NOTE: If = True, JSON-only mode is automatically forced off
MQTT_PUB_KV_WITH_JSON = True

# Whether to group messages by zone
#   True  →   zones/kitchen/...
#   False →   <device>/msg_code
MQTT_GROUP_BY_ZONE = True

# Use legacy topic layout (pre-v4 format)
MQTT_LEGACY_TOPIC_STRUCTURE = False

# ROOT topic for all MQTT output
MQTT_ROOT_TOPIC = evohome/mygateway

# Topic for commands sent TO evoGateway - this is always relative to the root topic
MQTT_CMD_TOPIC = system/_command

# Legacy-only topics
MQTT_SYSTEM_SUBTOPIC = system
MQTT_ZONE_UNKNOWN_SUBTOPIC = _zone_unknown
MQTT_ZONES_SUBTOPIC = zones
MQTT_CONTROLLERS_SUBTOPIC = controllers
MQTT_RELAYS_SUBTOPIC = relays

# DHW handling
# If True, DHW is treated as a "zone" (recommended)
MQTT_DHW_IS_ZONE = True

# Subtopic for DHW
MQTT_DHW_ZONE_SUBTOPIC = _dhw


# --- Home Assistant MQTT Discovery ---

# Enable HA MQTT auto-discovery
HA_DISCOVERY_ENABLED = False

# HA discovery prefix (must match HA's own discovery_prefix setting)
# HA_DISCOVERY_PREFIX = homeassistant

# Prefix for all HA device/entity unique IDs.
# Defaults to snake_case of MQTT_CLIENTID if not set.
# Set explicitly when running dev and prod gateways against the same HA instance.
# HA_DISCOVERY_ID_PREFIX = my_gateway

# Text prepended/appended to zone climate entity names.
# e.g. prefix="" suffix="Heating" → "Living Room Heating"
#      prefix="Zone" suffix=""    → "Zone Living Room"
# HA_ZONE_CLIMATE_PREFIX =
HA_ZONE_CLIMATE_SUFFIX = Heating

# Advanced: override DHW sub-topics used for HA discovery (relative to {root}/zones/{dhw_slug}/).
# Leave commented out to auto-detect from device registry (recommended).
# HA_DHW_TEMP_SUBTOPIC   = dhw_wireless_sender/dhw_temp
# HA_DHW_PARAMS_SUBTOPIC = dhw_wireless_sender/dhw_params
# HA_DHW_MODE_SUBTOPIC   = ctl_controller/dhw_mode



#------------------------------------------------------------------------------
# RAMSES_RF ENGINE SETTINGS
#------------------------------------------------------------------------------
[Ramses_rf]

# Disable radio sending entirely (monitor-only mode)
DISABLE_SENDING = False

# Enable device discovery (recommend disabled)
ENABLE_DISCOVERY = False

# Enable eavesdropping mode (deep discovery, more noise - recommend disabled for production)
ENABLE_EAVESDROP = False

# Use a known-list of devices only (recommended)
KNOWN_LIST = True



#------------------------------------------------------------------------------
# WATCHDOG SETTINGS
#------------------------------------------------------------------------------
[Watchdog]

# How often (seconds) to re-publish the MQTT Online heartbeat on the status topic.
# Consumers (e.g. Home Assistant) can compare the status_ts field against wall
# clock to detect a stale gateway even when MQTT stays connected.
# Set to 0 to disable the heartbeat entirely.
MQTT_HEARTBEAT_INTERVAL = 300

# RF silence thresholds — all measured in seconds from the last received RF message.
# Set any value to 0 to disable that stage. Stages are independent — Stage 2
# does not require Stage 1 to have fired first.
#
# Stage 1 – Warning: log a warning and publish status "RF Timeout" to MQTT.
#            Set to 0 to disable.
RF_WARN_TIMEOUT = 900

# Stage 2 – RF Restart: attempt to restart the RF (ramses_rf) layer only.
#            Fires when silence >= RF_RESTART_TIMEOUT regardless of Stage 1.
#            Set to 0 to disable (also disables Stages 3 and 4).
RF_RESTART_TIMEOUT = 1800

# Stages 3 and 4 are both measured from when the Stage 2 RF restart was attempted.

# Stage 3 – Process Restart: restart the whole Python process via os.execv
#            (no external process manager needed). Set to 0 to disable.
RF_PROCESS_RESTART_TIMEOUT = 900

# Stage 4 – Exit: raise SystemExit so the process manager (e.g. systemd) can
#            restart the whole service. Only reachable if Stage 3 is disabled
#            or RF_EXIT_TIMEOUT < RF_PROCESS_RESTART_TIMEOUT.
#            Set to 0 to disable.
RF_EXIT_TIMEOUT = 1800



#------------------------------------------------------------------------------
# MISCELLANEOUS SETTINGS
#------------------------------------------------------------------------------
[Misc]

# Friendly name for your gateway/HGI 
THIS_GATEWAY_NAME = evoGateway

# Width of formatted console rows
MIN_ROW_LENGTH = 160

# Merge messages from RF bit-error corrupted device IDs into the known canonical device.
# Only applies when exactly one device of that type is registered (safe singleton check).
# OTB and HGI default on (no valid multi-device scenario); CTL defaults off (multi-system is legitimate).
MERGE_UNKNOWN_OTB = True
MERGE_UNKNOWN_HGI = True
MERGE_UNKNOWN_CTL = False

# Console colours (Python dict expression)
# Leave blank to use defaults
DISPLAY_COLOURS =

# Use local OS timezone for timestamps (True = DST-aware local time, False = system default).
USE_LOCAL_TIME = False

# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL = INFO

# Print events to the console
EVENTS_CONSOLE_OUTPUT = False

# Log events with friendly device names (recommended)
EVENTS_LOG_WITH_DEVICE_NAMES = True
